# Signing key for the admin session and the contact form's timing token.
#   openssl rand -base64 32
AUTH_SECRET=

# Admin login. Generate with: npm run hash-password -- 'your password'
ADMIN_PASSWORD_HASH=

# Cloudflare Turnstile. Without these the documented always-passes test keys are
# used locally; in production a missing secret refuses every submission.
# The widget must list every hostname it is embedded on (apex, www, localhost),
# and its `action` must stay "contact" — see lib/turnstile-shared.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=lagerqvr.com,www.lagerqvr.com,localhost

# Contact delivery (Resend, provisioned via the Vercel Marketplace).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <noreply@lagerqvr.com>

# Optional: raises the GitHub API rate limit for the repository list.
GITHUB_AUTH_TOKEN=

# Set automatically by Vercel Blob.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=https://lagerqvr.com
